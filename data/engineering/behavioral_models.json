    "high_anger",
    "disengaged"
  ],
  "simulation_hooks": {
    "digital_twin": "Designed for offline event-sequence simulation without LLM; not yet published as a standalone public runner in this site package.",
    "sensitivity_analysis": "No published results",
    "parameter_sweep": "No published results",
    "state_traces": "No fabricated traces — runtime event_log exists in engine but private agent logs are not exported here"
  }
}
