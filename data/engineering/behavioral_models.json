{
  "behavior_model_version": "BM-EMO-1.0",
  "personality_schema_version": "PS-EMO-1.0",
  "relationship_model_versions": ["RM-F5-1.0", "RM-RB-1.0"],
  "source_modules": [
    "continuity/emotional_continuity.py",
    "continuity/relationship.py",
    "learning/user_relationship_engine.py"
  ],
  "calibration": {
    "note": "Personality coefficients in _PROFILES appear manually tuned for character differentiation. Do not describe them as scientifically derived unless separate evidence is published.",
    "parameters": []
  },
  "models": [
    {
      "id": "MOD-EMO-001",
      "name": "Emotional Continuity State Model",
      "purpose": "Accumulate per-agent continuous affect so Codec replies track history instead of one-shot mood lines.",
      "implementation": "continuity/emotional_continuity.py",
      "state_variables": [
        {"symbol": "I", "name": "irritation", "range": [0, 1], "default": 0.08, "timescale": "fast"},
        {"symbol": "J", "name": "jealousy", "range": [0, 1], "default": 0.05, "timescale": "fast"},
        {"symbol": "H", "name": "hurt", "range": [0, 1], "default": 0.04, "timescale": "fast"},
        {"symbol": "T", "name": "trust", "range": [0, 1], "default": 0.72, "timescale": "slow"},
        {"symbol": "A", "name": "attachment", "range": [0, 1], "default": "0.78 (albedo) / 0.65 (others)", "timescale": "slow"},
        {"symbol": "C", "name": "confidence", "range": [0, 1], "default": 0.75, "timescale": "slow"},
        {"symbol": "X", "name": "anxiety", "range": [0, 1], "default": 0.12, "timescale": "fast"},
        {"symbol": "Ac", "name": "apology_credibility", "range": [0, 1], "default": 0.85, "timescale": "slow"}
      ],
      "vector_form": "E(t) = [irritation, jealousy, hurt, trust, attachment, confidence, anxiety] with auxiliary apology_credibility, rival_heat, counters",
      "clamp": "All continuous dims use _clamp(x, 0, 1)",
      "blend_rule": {
        "name": "_blend(current, delta, inertia)",
        "positive_delta": "gain = delta * (0.78 + 0.22 * (1 - inertia * 0.25)); new = clamp(current + gain)",
        "negative_delta": "new = clamp(current + delta * (1 - inertia))",
        "notes": "Hostile events accrue more readily; repair is attenuated by inertia."
      },
      "time_decay": {
        "unit": "≈90s idle per step, max 12 steps",
        "rule": "decay = decay_per_neutral * steps; I,J,H,X -= decay; C += (0.75 - C) * 0.04 * steps"
      },
      "comparison_event": {
        "jel_d": "0.16 * comparison_sensitivity * (1 + 0.12 * min(6, n))",
        "irr_d": "0.13 * comparison_sensitivity * (1 + 0.10 * min(6, n))",
        "hurt_d": "0.11 * rejection_sensitivity",
        "trust": "T = clamp(T - 0.05 * trust_damage)",
        "rival_heat": "heat[r] = clamp(heat[r] + 0.22)"
      },
      "linked_requirements": ["REQ-BEH-001", "REQ-BEH-002"],
      "linked_tests": ["BVT-001", "BVT-002", "UT-001"],
      "linked_risks": ["RSK-006"],
      "status": "Implemented",
      "verification_status": "Verification Pending"
    },
    {
      "id": "MOD-PER-001",
      "name": "Personality Parameter Vector",
      "purpose": "Per-agent knobs modulating emotional updates",
      "implementation": "_PROFILES in emotional_continuity.py",
      "vector_form": "P = [comparison_sensitivity, rejection_sensitivity, loyalty_weight, anger_inertia, jealousy_inertia, attachment_inertia, trust_recovery, trust_damage, disengage_threshold, decay_per_neutral]",
      "profiles": {
        "albedo": {
          "comparison_sensitivity": 0.92,
          "rejection_sensitivity": 0.88,
          "loyalty_weight": 0.94,
          "anger_inertia": 0.78,
          "jealousy_inertia": 0.88,
          "attachment_inertia": 0.94,
          "trust_recovery": 0.22,
          "trust_damage": 0.55,
          "disengage_threshold": 0.82,
          "decay_per_neutral": 0.035
        },
        "mei_ling": {
          "comparison_sensitivity": 0.55,
          "rejection_sensitivity": 0.70,
          "loyalty_weight": 0.60,
          "anger_inertia": 0.62,
          "jealousy_inertia": 0.45,
          "attachment_inertia": 0.70,
          "trust_recovery": 0.35,
          "trust_damage": 0.40,
          "disengage_threshold": 0.88,
          "decay_per_neutral": 0.05
        },
        "naomi_hunter": {
          "comparison_sensitivity": 0.50,
          "rejection_sensitivity": 0.65,
          "loyalty_weight": 0.55,
          "anger_inertia": 0.58,
          "jealousy_inertia": 0.35,
          "attachment_inertia": 0.60,
          "trust_recovery": 0.30,
          "trust_damage": 0.50,
          "disengage_threshold": 0.90,
          "decay_per_neutral": 0.045
        },
        "kurumi": {
          "comparison_sensitivity": 0.85,
          "rejection_sensitivity": 0.80,
          "loyalty_weight": 0.75,
          "anger_inertia": 0.70,
          "jealousy_inertia": 0.82,
          "attachment_inertia": 0.85,
          "trust_recovery": 0.28,
          "trust_damage": 0.48,
          "disengage_threshold": 0.85,
          "decay_per_neutral": 0.04
        },
        "solid_snake": {
          "comparison_sensitivity": 0.15,
          "rejection_sensitivity": 0.40,
          "loyalty_weight": 0.70,
          "anger_inertia": 0.55,
          "jealousy_inertia": 0.10,
          "attachment_inertia": 0.65,
          "trust_recovery": 0.12,
          "trust_damage": 0.75,
          "disengage_threshold": 0.92,
          "decay_per_neutral": 0.06
        },
        "_default": {
          "comparison_sensitivity": 0.60,
          "rejection_sensitivity": 0.55,
          "loyalty_weight": 0.65,
          "anger_inertia": 0.65,
          "jealousy_inertia": 0.55,
          "attachment_inertia": 0.70,
          "trust_recovery": 0.30,
          "trust_damage": 0.45,
          "disengage_threshold": 0.88,
          "decay_per_neutral": 0.045
        }
      },
      "coupling": "Δemotion = base_event_effect × personality_sensitivity (and inertia via _blend)",
      "linked_requirements": ["REQ-BEH-002"],
      "linked_tests": ["BVT-002"],
      "status": "Implemented"
    },
    {
      "id": "MOD-REL-001",
      "name": "Agent Relationship Formula 5",
      "purpose": "Bounded agent↔agent relationship strength with slow drift to neutral",
      "implementation": "continuity/relationship.py",
      "equation": "new = clamp(cur + delta - 0.008 * (cur - 0.50), 0, 1)",
      "constants": {"NEUTRAL": 0.50, "DRIFT": 0.008},
      "directionality": "Directed edges (from_id → to_id); asymmetric by construction",
      "event_deltas_sample": {
        "social_mention_positive": [["ally", 0.022], ["colleague", 0.012]],
        "social_mention_negative": [["rival", 0.022], ["adversary", 0.012], ["ally", -0.035]],
        "rex_proposal_support": [["ally", 0.032]],
        "operator_ask": [["ally", 0.006], ["colleague", 0.004]],
        "same_question_to_other_agent": [["rival", 0.028], ["ally", -0.032], ["colleague", -0.012]]
      },
      "operator_levels": {
        "familiar": "ally > 0.63",
        "reserved": "ally < 0.40",
        "neutral": "otherwise"
      },
      "linked_requirements": ["REQ-REL-001"],
      "linked_tests": ["UT-002"],
      "status": "Implemented"
    },
    {
      "id": "MOD-REL-002",
      "name": "User Bond Formula RB",
      "purpose": "Persona→user emotional bond distinct from Formula 5 org relationships",
      "implementation": "learning/user_relationship_engine.py",
      "constants": {
        "DRIFT_RATE": 0.005,
        "RESIDUE_DECAY": 0.88,
        "MEMORY_SALIENCE_MIN": 0.55,
        "PRESSURE_THRESHOLD": 0.60,
        "ABSENCE_HOURS_SOFT": 6,
        "ABSENCE_HOURS_HARD": 24
      },
      "archetype_dimensions": [
        "bond_level",
        "trust",
        "affection",
        "protectiveness",
        "deference",
        "fascination",
        "jealousy_tendency",
        "possessiveness_tendency",
        "warmth",
        "playfulness",
        "formality"
      ],
      "notes": "Archetype defaults exist (e.g. reverent_devotion, trusted_operator_confidant). Full archetype table lives in source; Engineering lists dimensions and constants only.",
      "status": "Implemented",
      "verification_status": "Verification Pending"
    },
    {
      "id": "MOD-JEAL-001",
      "name": "Jealousy / Comparison Pathway",
      "purpose": "Map comparison/insult events into jealousy and rival_heat",
      "parent_model": "MOD-EMO-001",
      "rule_set": "Conditional on classified turn kind == comparison|insult; not a single closed-form J = f(...) for all inputs",
      "conceptual_factors": [
        "comparison_sensitivity",
        "rejection_sensitivity",
        "comparison_count n",
        "rival identity aliases",
        "jealousy_inertia via _blend"
      ],
      "status": "Implemented"
    },
    {
      "id": "MOD-TRUST-001",
      "name": "Trust Gain/Loss",
      "purpose": "Asymmetric trust damage vs recovery",
      "parent_model": "MOD-EMO-001",
      "damage": "On comparison/insult: T -= 0.05 * trust_damage (profile)",
      "recovery": "genuine_repair: T += trust_recovery * (0.55 + 0.45 * apology_credibility) * 0.35; cooperative adds trust_recovery * 0.18",
      "notes": "trust_recovery << 1 and albedo trust_recovery=0.22 → regain slower than many damage events",
      "status": "Implemented"
    },
    {
      "id": "MOD-ATT-001",
      "name": "Attachment",
      "purpose": "Slow relational bond dimension in E(t)",
      "parent_model": "MOD-EMO-001",
      "notes": "Default attachment higher for albedo (0.78). attachment_inertia in profile; detailed attachment growth equations beyond defaults/events are source-defined per event branch.",
      "status": "Implemented"
    },
    {
      "id": "MOD-RIVAL-001",
      "name": "Rival Heat",
      "purpose": "Per-rival association strength map rival_heat[r]",
      "parent_model": "MOD-EMO-001",
      "update": "On comparison with detected rival alias: heat[r] = clamp(heat[r] + 0.22)",
      "status": "Implemented"
    }
  ],
  "event_classes": [
    "comparison",
    "insult",
    "minimize",
    "apology",
    "genuine_repair",
    "cooperative",
    "technical",
    "topic_switch",
    "baseline",
